# ELI — variables de entorno. Copia este archivo a .env.local. Todas tienen fallback:
# sin ninguna clave la app funciona con AI_PROVIDER=mock. Lista canónica: tasks.md § 6.6.

# --- IA ---
# Proveedor: anthropic | openrouter | mock. Si se omite: anthropic si hay ANTHROPIC_API_KEY,
# openrouter si solo hay OPENROUTER_API_KEY, mock en cualquier otro caso.
AI_PROVIDER=
# Anthropic (proveedor principal). La organización necesita retención de datos de 30 días.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
# low | medium | high. low = menor latencia para un chat infantil.
ANTHROPIC_EFFORT=low
# Modelo de respaldo si el principal rehúsa (opcional, activa el beta de fallbacks).
ANTHROPIC_FALLBACK_MODEL=
# OpenRouter (segundo proveedor): una sola clave para chat, imágenes, voz→texto y texto→voz. Estos
# son los valores por defecto de base_model / visual_model / stt_model / tts_model (lib/config/registry.ts).
# Lo guardado desde /admin (Postgres, con caché en Redis) manda sobre estas variables. Ver tasks.md 6.6 y 6.13.
OPENROUTER_API_KEY=
# base_model: responde las preguntas (solo texto, gratis). Alternativa: openrouter/free (router de modelos gratis).
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# visual_model: interpreta las fotos (entiende imagen, no la genera; también acepta vídeo). Gratis.
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
# visual_fallback_model: respaldo de las preguntas con foto (debe aceptar imágenes). El visual gratuito comparte
# cuota en su proveedor y a veces responde 429; este es de otro proveedor.
OPENROUTER_VISION_FALLBACK_MODEL=qwen/qwen3.8-27b:free
# base_fallback_model: se prueba UNA vez si el modelo base falla, no responde a tiempo o devuelve su
# razonamiento en vez de una respuesta (solo en preguntas sin foto). Vacío = el de por defecto.
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731:free
# Si un intento no da texto visible en este tiempo se aborta y se pasa al respaldo (debe ir muy por debajo de los 60 s de la función).
OPENROUTER_FIRST_TOKEN_TIMEOUT_MS=20000
# stt_model: voz → texto por /audio/transcriptions (acepta webm). No hay STT gratuito: ~$0.012 por hora de audio.
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo
# tts_model: texto → voz por /audio/speech (gratis, sin garantías de disponibilidad). tts_voice: vacío = sin voz explícita.
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_VOICE=
# TTS de respaldo si el principal falla (de pago: ~$0.6–4 por millón de caracteres). Vacío = sin respaldo.
OPENROUTER_TTS_FALLBACK_MODEL=hexgrad/kokoro-82m
OPENROUTER_TTS_FALLBACK_VOICE=ef_dora
# Solo si NO hay OPENROUTER_API_KEY: Fish Audio directo (T-053). Sin ninguna clave, /api/speech responde
# 204 y el cliente usa speechSynthesis del navegador.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
# Guardas de coste.
AI_MAX_OUTPUT_TOKENS=1024
AI_WINDOW_PAIRS=6
AI_MAX_INPUT_CHARS=1000
# Retardo entre chunks del proveedor mock (0 en tests).
MOCK_DELAY_MS=30

# --- Datos (Neon). Sin DATABASE_URL se usa un repositorio en memoria. ---
# Cadena pooled de Neon (postgresql://...?sslmode=require). En local la trae `vercel env pull .env.local`.
# El SQL versionado en drizzle/ se aplica con `pnpm db:migrate`.
DATABASE_URL=

# --- Upstash Redis (rate limit). Sin credenciales, ventana en memoria del proceso. ---
# Vale cualquiera de los dos pares. El segundo es el que instala «Upstash for Redis» del Marketplace
# de Vercel (recurso eli-redis, plan free); en local lo trae `vercel env pull .env.local`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Peticiones por clave (userId ?? anonId ?? ip) y ventana deslizante: "10 m", "30 s", "1 h".
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=10 m

# --- Upstash QStash (persistencia asíncrona). Sin token, persistencia inline. ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Supabase Auth (M3). Sin variables, modo anónimo. ---
# Si la integración de Supabase del Marketplace de Vercel instaló sus variables con
# prefijo ELI_/NEXT_PUBLIC_ELI_ (NEXT_PUBLIC_ELI_SUPABASE_URL, NEXT_PUBLIC_ELI_SUPABASE_ANON_KEY,
# ELI_SUPABASE_SERVICE_ROLE_KEY), no hace falta copiarlas aquí: lib/env.ts y
# lib/supabase/client.ts caen a esos nombres automáticamente si estas no están puestas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REQUIRED=false
# Correos separados por comas con acceso a /admin (M7). Vacío: nadie entra.
ADMIN_EMAILS=

# --- Operación ---
# Presupuesto diario de tokens; al superarlo /api/chat responde 503 amable.
DAILY_TOKEN_BUDGET=2000000
# CRÍTICO en producción: URL pública de la app. En local: http://localhost:3000.
# En Vercel (producción): https://eli.ngo. Si no se define correctamente, Supabase
# redirige a localhost y rompe el flujo de autenticación.
NEXT_PUBLIC_APP_URL=http://localhost:3000
